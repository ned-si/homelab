{
  // ---------------------------------------------------------------------------
  // COMMENT-DRIVEN dependency tracking.
  //
  // Every pinned version in this repo is preceded by a `# renovate:` comment
  // that tells Renovate exactly which datasource to query.
  //
  // CANONICAL FIELD ORDER -- this matters. Renovate regex managers use RE2,
  // which has no lookahead, so the fields cannot be parsed order-independently.
  // Always write them in this order, with depName immediately after datasource:
  //
  //   # renovate: datasource=<ds> depName=<name> [packageName=] [registryUrl=] [versioning=] [extractVersion=]
  //
  // Examples:
  //
  //   # renovate: datasource=helm depName=cilium registryUrl=https://helm.cilium.io
  //   targetRevision: 1.16.3
  //
  //   # renovate: datasource=docker depName=ghcr.io/hotio/qbittorrent
  //   image: ghcr.io/hotio/qbittorrent:release-5.2.3
  //
  //   # renovate: datasource=github-releases depName=kubernetes-sigs/gateway-api
  //   - https://github.com/.../releases/download/v1.2.0/experimental-install.yaml
  //
  // Verify with `node scripts/renovate-dryrun.js`, which applies these regexes
  // to the tree and fails if any annotation yields no match. Run it after
  // touching either this file or an annotation.
  //
  // The native `helm-values`, `helmv3` and `argocd` managers are deliberately
  // DISABLED so a dependency is never tracked twice and so that adding a tracked
  // version is always an explicit, reviewable act.
  //
  // `managerFilePatterns` requires Renovate >= 41 (the hosted GitHub App is
  // always current). On an older self-hosted runner, rename it to `fileMatch`.
  // ---------------------------------------------------------------------------

  extends: [
    'config:recommended',
    ':dependencyDashboard',
    ':semanticCommits',
  ],

  timezone: 'Europe/Zurich',
  schedule: ['* 0-6 * * 1'],
  prConcurrentLimit: 5,
  prHourlyLimit: 0,
  labels: ['dependencies', 'renovate'],
  separateMinorPatch: true,

  enabledManagers: [
    'custom.regex',
    'terraform',
    'github-actions',
  ],

  customManagers: [
    {
      customType: 'regex',
      description: 'Annotated version on a known key. Deliberately excludes `image:` and `imageName:` -- those carry a full `repo:tag` reference and are handled by the next manager. Matching both here would double-report every container and capture the repo as the version.',
      managerFilePatterns: [
        '/\\.ya?ml$/',
        '/\\.tf$/',
        '/\\.sh$/',
        '/Makefile$/',
      ],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=(?<datasource>[a-z-]+)(?:\\s+depName=(?<depName>[^\\s]+))?(?:\\s+packageName=(?<packageName>[^\\s]+))?(?:\\s+registryUrl=(?<registryUrl>[^\\s]+))?(?:\\s+versioning=(?<versioning>[^\\s]+))?(?:\\s+extractVersion=(?<extractVersion>[^\\s]+))?[^\\n]*\\n\\s*(?:targetRevision|version|tag|chart|[A-Z][A-Z0-9_]*)\\s*[:=]+\\s*[\'"]?(?<currentValue>[^\'"\\s]+)[\'"]?',
      ],
      datasourceTemplate: '{{{datasource}}}',
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}',
    },
    {
      customType: 'regex',
      description: 'Annotated `image:`/`imageName:` reference carrying a full repo:tag. Captures only the tag. `imageName` is what CloudNativePG Clusters use.',
      managerFilePatterns: ['/\\.ya?ml$/'],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=docker\\s+depName=(?<depName>[^\\s]+)(?:\\s+versioning=(?<versioning>[^\\s]+))?[^\\n]*\\n\\s*-?\\s*(?:image|imageName):\\s*[\'"]?[^\\s:\'"]+:(?<currentValue>[^\'"\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?[\'"]?',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}',
    },
    {
      customType: 'regex',
      description: 'Annotated GitHub release-asset URL, e.g. the Gateway API CRD bundle. The version sits mid-path so the generic manager above cannot reach it.',
      managerFilePatterns: ['/\\.ya?ml$/'],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=github-releases\\s+depName=(?<depName>[^\\s]+)[^\\n]*\\n(?:[^\\n]*\\n){0,3}?[^\\n]*/releases/download/(?<currentValue>[^/\\s]+)/',
      ],
      datasourceTemplate: 'github-releases',
    },
    {
      customType: 'regex',
      description: 'Annotated raw.githubusercontent.com URL, for manifests vendored from a TAGGED PATH in a repo rather than published as a release asset -- e.g. the external-snapshotter CRDs. The tag sits mid-path, and it is not a /releases/download/ URL, so neither manager above can reach it. Several URLs usually follow one annotation, and only the first needs to match: Renovate rewrites every occurrence of the old version in the file.',
      managerFilePatterns: ['/\\.ya?ml$/'],
      matchStrings: [
        '#\\s*renovate:\\s*datasource=github-releases\\s+depName=(?<depName>[^\\s]+)[^\\n]*\\n(?:[^\\n]*\\n){0,3}?[^\\n]*raw\\.githubusercontent\\.com/[^/]+/[^/]+/(?<currentValue>[^/\\s]+)/',
      ],
      datasourceTemplate: 'github-releases',
    },
  ],

  packageRules: [
    {
      description: 'Make Helm chart PR titles obvious',
      matchDatasources: ['helm'],
      commitMessageTopic: 'chart {{depName}}',
    },
    {
      // Cilium ships against a specific Gateway API version. If these drift the
      // Gateway stops programming and every HTTPRoute goes dark.
      description: 'Cilium and Gateway API CRDs move together, reviewed by hand',
      groupName: 'cluster networking',
      matchDepNames: ['cilium', 'kubernetes-sigs/gateway-api'],
      automerge: false,
      labels: ['dependencies', 'renovate', 'needs-manual-review'],
    },
    {
      // The *arr apps and qBittorrent share a download-client credential
      // contract. Bumping qBittorrent alone is what broke this cluster once.
      description: 'theater stack moves as one unit',
      groupName: 'theater stack',
      matchPackageNames: ['/^ghcr\\.io\\/hotio\\//'],
      automerge: false,
    },
    {
      description: 'hotio images use `release-<x.y.z.build>` tags, which are not semver',
      matchPackageNames: ['/^ghcr\\.io\\/hotio\\//'],
      versioning: 'regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?$',
    },
    {
      description: 'Immich majors run irreversible DB migrations, never automatic',
      matchDepNames: ['immich', 'ghcr.io/immich-app/immich-server'],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
      labels: ['dependencies', 'renovate', 'needs-manual-review'],
    },
    {
      description: 'Postgres / VectorChord majors refuse to start on an existing datadir',
      matchPackageNames: [
        '/cloudnative-vectorchord/',
        '/postgres/',
        '/^mariadb$/',
      ],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
      labels: ['dependencies', 'renovate', 'needs-manual-review'],
    },
    {
      description: 'Keycloak majors change OIDC defaults; every federated app is downstream',
      matchDepNames: ['quay.io/keycloak/keycloak'],
      matchUpdateTypes: ['major'],
      dependencyDashboardApproval: true,
      labels: ['dependencies', 'renovate', 'needs-manual-review'],
    },
    {
      // Seafile's community image has no orderable patch tags, so the manifest
      // pins a floating 11.0.x minor tag on purpose. Nothing to update.
      description: 'Seafile is pinned to a floating minor tag by design',
      matchPackageNames: ['/^seafileltd\\/seafile-mc$/'],
      enabled: false,
    },
    {
      description: 'Auto-merge patch bumps of leaf applications only',
      matchDatasources: ['docker'],
      matchUpdateTypes: ['patch'],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true,
    },
    {
      description: 'Pin OpenTofu providers exactly',
      matchManagers: ['terraform'],
      rangeStrategy: 'pin',
    },
  ],

  vulnerabilityAlerts: {
    labels: ['security'],
    schedule: ['at any time'],
    prCreation: 'immediate',
  },

  osvVulnerabilityAlerts: true,
}
