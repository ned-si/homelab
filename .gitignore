# ---------------------------------------------------------------------------
# Secrets: never commit anything decrypted.
# Only `*.sops.yaml` (SOPS-encrypted) may be committed.
# ---------------------------------------------------------------------------
*.dec.yaml
*.dec.yml
*.plain.yaml
*.plain.yml
*.key
*.pem
key.txt
age.key
age.agekey
.env
.env.*

# Decrypted output produced by `task secrets:decrypt` for local rendering.
/.decrypted/

# Crib sheet written by scripts/secrets-inventory.sh. Contains LIVE credentials
# in plaintext. The script refuses to run if this is not ignored.
secrets-to-encrypt.local.md
# Any `<name>.local.<ext>` file is a local-only working copy (plaintext secrets,
# password-manager exports). Covers *.local.env below as well.
*.local.*

# Personal notes kept beside the docs; never published.
/docs/logs/
/docs/todo.md

# Kubeconfigs
kubeconfig*
!kubeconfig*.example
*.kubeconfig

# ---------------------------------------------------------------------------
# OpenTofu / Terraform
# ---------------------------------------------------------------------------
**/.terraform/*
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# ---------------------------------------------------------------------------
# Local build output / OS noise
# ---------------------------------------------------------------------------
/tmp/
/build/
.DS_Store
*.swp

# Clear-text secret source of truth for scripts/seal-secrets-from-env.sh
*.local.env

# Python bytecode. This repository had no Python until scripts/lib/trivy_*.py, so
# these patterns were never needed before -- `python3 -m py_compile` on those two
# files is what created the first __pycache__ and it very nearly got committed.
__pycache__/
*.py[cod]
