# TEMPLATE -- copy to signoz-backup-s3.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/signoz-backup-s3.sops.yaml
# (or scripts/seal-secrets-from-env.sh, from S3_ACCESS_KEY_ID,
# S3_SECRET_ACCESS_KEY and RESTIC_PASSWORD in secrets.local.env).
#
# The writer's copy of `s3-backup` (platform/secrets/s3-backup.sops.yaml.example)
# for the namespace `signoz`, read by the CronJob signoz-backup
# (platform/signoz/resources/backup.yaml). A file of its own so adding it did
# not re-seal the shared one. RESTIC_PASSWORD must be byte-identical to the
# other copies: it is the repositories' encryption key.
---
apiVersion: v1
kind: Secret
metadata:
  name: s3-backup
  namespace: signoz
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: PUT_THE_S3_ACCESS_KEY_HERE
  AWS_SECRET_ACCESS_KEY: PUT_THE_S3_SECRET_KEY_HERE
  AWS_DEFAULT_REGION: eu-central-1
  RESTIC_PASSWORD: PUT_A_GENERATED_RESTIC_REPOSITORY_PASSWORD_HERE
