# TEMPLATE -- copy to headlamp-sso.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/headlamp-sso.sops.yaml
# (or scripts/seal-secrets-from-env.sh, from HEADLAMP_SSO_CLIENT_SECRET and
# HEADLAMP_SSO_COOKIE_SECRET in secrets.local.env).
#
# The oauth2-proxy `headlamp-sso` (platform/headlamp/resources/sso.yaml):
#   client-secret     the secret of the Keycloak client `headlamp`. The
#                     keycloak-realm-settings Job sets it on the client from
#                     the second Secret below, which holds the same value.
#                     Generate: openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-48
#   cookie-secret     32 characters. Generate: openssl rand -hex 16
---
apiVersion: v1
kind: Secret
metadata:
  name: headlamp-sso
  namespace: headlamp
type: Opaque
stringData:
  client-secret: "PUT_THE_HEADLAMP_CLIENT_SECRET_HERE"
  cookie-secret: "PUT_THE_HEADLAMP_COOKIE_SECRET_HERE"
---
# Read by the keycloak-realm-settings Job (platform/keycloak/realm-settings.yaml)
# as HEADLAMP_CLIENT_SECRET, the variable apply.sh reads for `proxy_clients`
# entry `headlamp`.
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-headlamp-client
  namespace: keycloak
type: Opaque
stringData:
  HEADLAMP_CLIENT_SECRET: "PUT_THE_HEADLAMP_CLIENT_SECRET_HERE"
