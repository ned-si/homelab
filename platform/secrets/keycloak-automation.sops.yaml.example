# TEMPLATE -- copy to keycloak-automation.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/keycloak-automation.sops.yaml
# (or scripts/seal-secrets-from-env.sh, from
# KEYCLOAK_REALM_SETTINGS_CLIENT_SECRET in secrets.local.env).
#
# The secret of the master client `realm-settings` (platform.conf
# `automation_client`): the keycloak-realm-settings Job logs in with it and
# sets it on the client. It is also the break-glass credential of the
# Keycloak admin (docs/runbooks/keycloak-otp.md).
# Generate: openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-48
---
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-automation
  namespace: keycloak
type: Opaque
stringData:
  REALM_SETTINGS_CLIENT_SECRET: "PUT_THE_REALM_SETTINGS_CLIENT_SECRET_HERE"
