# TEMPLATE -- copy to hubble-sso.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/hubble-sso.sops.yaml
# (or scripts/seal-secrets-from-env.sh, from HUBBLE_SSO_CLIENT_SECRET and
# HUBBLE_SSO_COOKIE_SECRET in secrets.local.env).
#
# The oauth2-proxy `hubble-sso` (platform/hubble-access/sso.yaml):
#   client-secret     the secret of the Keycloak client `hubble`. The
#                     keycloak-realm-settings Job sets it on the client from
#                     the second Secret below, which holds the same value.
#                     Generate: openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-48
#   cookie-secret     32 characters. Generate: openssl rand -hex 16
---
apiVersion: v1
kind: Secret
metadata:
  name: hubble-sso
  namespace: hubble
type: Opaque
stringData:
  client-secret: "PUT_THE_HUBBLE_CLIENT_SECRET_HERE"
  cookie-secret: "PUT_THE_HUBBLE_COOKIE_SECRET_HERE"
---
# Read by the keycloak-realm-settings Job (platform/keycloak/realm-settings.yaml)
# as HUBBLE_CLIENT_SECRET, the variable apply.sh reads for `proxy_clients`
# entry `hubble`.
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-hubble-client
  namespace: keycloak
type: Opaque
stringData:
  HUBBLE_CLIENT_SECRET: "PUT_THE_HUBBLE_CLIENT_SECRET_HERE"
