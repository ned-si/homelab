# TEMPLATE -- copy to argocd-notifications.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/argocd-notifications.sops.yaml
#
# The GitHub token Argo CD Notifications uses to send the `argo-degraded`
# repository_dispatch that runs .github/workflows/auto-rollback.yaml
# (`notifications.secret.name` in bootstrap/argocd-values.yaml).
#
# Fine-grained token, resource owner ned-si, repository ned-si/homelab only:
#   Contents, Pull requests, Issues: Read and write
# The same token is the Actions secret AUTO_ROLLBACK_TOKEN: a pull request
# opened with the workflow's own token would not start CI. A PENDING
# sentinel leaves automatic rollback off.
---
apiVersion: v1
kind: Secret
metadata:
  name: argocd-notifications-github
  namespace: argo
type: Opaque
stringData:
  github-token: PUT_THE_AUTO_ROLLBACK_GITHUB_TOKEN_HERE
