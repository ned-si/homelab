# TEMPLATE -- copy to signoz-sso.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/signoz-sso.sops.yaml
# (or scripts/seal-secrets-from-env.sh, from SIGNOZ_SSO_CLIENT_SECRET,
# SIGNOZ_SSO_COOKIE_SECRET and SIGNOZ_ADMIN_PASSWORD in secrets.local.env).
#
# The oauth2-proxy `signoz-sso` (platform/signoz/resources/sso.yaml):
#   client-secret     the secret of the Keycloak client `signoz`. The
#                     keycloak-realm-settings Job sets it on the client from
#                     the second Secret below, which holds the same value.
#                     Generate: openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-48
#   cookie-secret     32 characters. Generate: openssl rand -hex 16
#   admin-password    SigNoz's own admin login behind the proxy (the first
#                     account registered in the UI, user `admin@lilalala.com`).
#                     Not read by any pod: the record of the password.
#                     Generate: openssl rand -base64 24 | tr -d '\n=+/'
---
apiVersion: v1
kind: Secret
metadata:
  name: signoz-sso
  namespace: signoz
type: Opaque
stringData:
  client-secret: "PUT_THE_SIGNOZ_CLIENT_SECRET_HERE"
  cookie-secret: "PUT_THE_SIGNOZ_COOKIE_SECRET_HERE"
  admin-password: "PUT_THE_SIGNOZ_ADMIN_PASSWORD_HERE"
---
# Read by the keycloak-realm-settings Job (platform/keycloak/realm-settings.yaml)
# as SIGNOZ_CLIENT_SECRET, the variable apply.sh reads for `proxy_clients`
# entry `signoz`.
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-signoz-client
  namespace: keycloak
type: Opaque
stringData:
  SIGNOZ_CLIENT_SECRET: "PUT_THE_SIGNOZ_CLIENT_SECRET_HERE"
