# TEMPLATE -- copy to cnpg-backup-s3.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/cnpg-backup-s3.sops.yaml
#
# S3 credential of the Barman Cloud plugin: WAL archiving and base backups of
# every CNPG cluster to s3://ned-si-homelab-backups/cnpg/<cluster>/.
#
# IAM user `ned-si-homelab-backups-cnpg` (bootstrap/aws-backup/), limited to the
# `cnpg/` prefix and unable to delete object versions. Values:
#     scripts/tofu.sh bootstrap/aws-backup output -raw cnpg_access_key_id
#     scripts/tofu.sh bootstrap/aws-backup output -raw cnpg_secret_access_key
#
# One copy per namespace that runs a CNPG cluster. The ObjectStore
# `cnpg-backup` in each namespace reads these two keys.
---
apiVersion: v1
kind: Secret
metadata:
  name: cnpg-backup-s3
  namespace: immich
type: Opaque
stringData:
  ACCESS_KEY_ID: PUT_THE_CNPG_S3_ACCESS_KEY_HERE
  ACCESS_SECRET_KEY: PUT_THE_CNPG_S3_SECRET_KEY_HERE
---
apiVersion: v1
kind: Secret
metadata:
  name: cnpg-backup-s3
  namespace: keycloak
type: Opaque
stringData:
  ACCESS_KEY_ID: PUT_THE_CNPG_S3_ACCESS_KEY_HERE
  ACCESS_SECRET_KEY: PUT_THE_CNPG_S3_SECRET_KEY_HERE
