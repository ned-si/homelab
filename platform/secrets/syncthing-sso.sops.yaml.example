# TEMPLATE -- copy to syncthing-sso.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/syncthing-sso.sops.yaml
# (or scripts/seal-secrets-from-env.sh, from SYNCTHING_SSO_CLIENT_SECRET and
# SYNCTHING_SSO_COOKIE_SECRET in secrets.local.env).
#
# The oauth2-proxy `syncthing-sso` (apps/syncthing/sso.yaml):
#   client-secret     the secret of the Keycloak client `syncthing`. The
#                     keycloak-realm-settings Job sets it on the client from
#                     the second Secret below, which holds the same value.
#                     Generate: openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-48
#   cookie-secret     32 characters. Generate: openssl rand -hex 16
---
apiVersion: v1
kind: Secret
metadata:
  name: syncthing-sso
  namespace: syncthing
type: Opaque
stringData:
  client-secret: "PUT_THE_SYNCTHING_CLIENT_SECRET_HERE"
  cookie-secret: "PUT_THE_SYNCTHING_COOKIE_SECRET_HERE"
---
# Read by the keycloak-realm-settings Job (platform/keycloak/realm-settings.yaml)
# as SYNCTHING_CLIENT_SECRET, the variable apply.sh reads for `proxy_clients`
# entry `syncthing`.
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-syncthing-client
  namespace: keycloak
type: Opaque
stringData:
  SYNCTHING_CLIENT_SECRET: "PUT_THE_SYNCTHING_CLIENT_SECRET_HERE"
