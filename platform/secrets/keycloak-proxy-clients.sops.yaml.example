# TEMPLATE -- copy to keycloak-proxy-clients.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/keycloak-proxy-clients.sops.yaml
#
# Client secrets of the oauth2-proxy clients in
# platform/keycloak/realm/platform.conf (`proxy_clients`). The
# keycloak-realm-settings Job sets each client's secret from its key. Each
# value must equal the one in the app's Secret:
#   THEATER_SSO_CLIENT_SECRET  = client-secret in apps/secrets/theater-sso.sops.yaml
# Generate with: openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-48
---
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-proxy-clients
  namespace: keycloak
type: Opaque
stringData:
  THEATER_SSO_CLIENT_SECRET: PUT_A_GENERATED_SECRET_HERE
