# TEMPLATE -- copy to usage-exporter.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/usage-exporter.sops.yaml
#
# Read-only API keys of the usage exporter (platform/usage-exporter), for the
# Homelab / Usage dashboard.
#
#   IMMICH_API_KEY    Immich -> an admin user -> Account Settings -> API Keys
#                     -> New API Key, permission `server.statistics` only.
#   JELLYFIN_API_KEY  Jellyfin -> Dashboard -> API Keys -> +, app name
#                     `usage-exporter`.
#
# Sealed with PENDING sentinels until the keys exist: the exporter leaves that
# source out (usage_source_configured 0) and the dashboard shows no data for
# it. To fill them in: put both values in secrets.local.env as
# USAGE_IMMICH_API_KEY and USAGE_JELLYFIN_API_KEY, delete
# platform/secrets/usage-exporter.sops.yaml and run
# scripts/seal-secrets-from-env.sh. The exporter reads the env at start, so
# restart it afterwards: kubectl -n monitoring rollout restart deploy/usage-exporter
---
apiVersion: v1
kind: Secret
metadata:
  name: usage-exporter
  namespace: monitoring
type: Opaque
stringData:
  IMMICH_API_KEY: PUT_THE_IMMICH_API_KEY_HERE
  JELLYFIN_API_KEY: PUT_THE_JELLYFIN_API_KEY_HERE
