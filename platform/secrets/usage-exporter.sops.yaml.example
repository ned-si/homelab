# TEMPLATE -- copy to usage-exporter.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/usage-exporter.sops.yaml
#
# API keys of platform/usage-exporter:
#   IMMICH_API_KEY    an admin user's API key, permission `server.statistics`
#   JELLYFIN_API_KEY  Dashboard -> API Keys, app `usage-exporter` (admin-level,
#                     cannot be scoped; docs/secrets.md)
#
# A PENDING sentinel leaves that source out. To change a key: set
# USAGE_IMMICH_API_KEY and USAGE_JELLYFIN_API_KEY in secrets.local.env, delete
# the sealed file and run scripts/seal-secrets-from-env.sh. The exporter reads
# the env at start, so bump `kubectl.kubernetes.io/restartedAt` in
# platform/usage-exporter/deployment.yaml after the Secret is live.
---
apiVersion: v1
kind: Secret
metadata:
  name: usage-exporter
  namespace: monitoring
type: Opaque
stringData:
  IMMICH_API_KEY: PUT_THE_IMMICH_API_KEY_HERE
  JELLYFIN_API_KEY: PUT_THE_JELLYFIN_API_KEY_HERE
