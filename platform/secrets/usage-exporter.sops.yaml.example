# TEMPLATE -- copy to usage-exporter.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/usage-exporter.sops.yaml
#
# API keys of the usage exporter (platform/usage-exporter), for the
# Homelab / Usage dashboard.
#
#   IMMICH_API_KEY    Immich -> an admin user -> Account Settings -> API Keys
#                     -> New API Key, permission `server.statistics` only.
#   JELLYFIN_API_KEY  Jellyfin -> Dashboard -> API Keys -> +, app name
#                     `usage-exporter`. Jellyfin API keys cannot be scoped:
#                     this one is admin-level (docs/secrets.md).
#
# A key not created yet is sealed as a PENDING sentinel: the exporter leaves
# that source out (usage_source_configured 0). To change a key: put both
# values in secrets.local.env as USAGE_IMMICH_API_KEY and
# USAGE_JELLYFIN_API_KEY, delete platform/secrets/usage-exporter.sops.yaml and
# run scripts/seal-secrets-from-env.sh. The exporter reads the env at start:
# once the Secret is live (Application secrets-platform synced), bump
# `kubectl.kubernetes.io/restartedAt` in
# platform/usage-exporter/deployment.yaml in a second pull request.
---
apiVersion: v1
kind: Secret
metadata:
  name: usage-exporter
  namespace: monitoring
type: Opaque
stringData:
  IMMICH_API_KEY: PUT_THE_IMMICH_API_KEY_HERE
  JELLYFIN_API_KEY: PUT_THE_JELLYFIN_API_KEY_HERE
