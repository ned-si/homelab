# TEMPLATE -- copy to grafana-oidc.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/grafana-oidc.sops.yaml
#
# This is the client secret of the `grafana` OIDC client in the `homelab` realm.
# The old value was committed in plaintext inside the kube-prometheus-stack
# values (`auth.generic_oauth.client_secret`). Regenerate the client secret in
# Keycloak -> Clients -> grafana -> Credentials before using this.
#
# The key name matters: Grafana resolves `$__env{GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET}`
# in grafana.ini from the process environment, and the chart injects this whole
# Secret with envFrom.
#
# Note the old client was called `grafana-oauth`; the new values use `grafana`.
# Either rename the client in Keycloak or change `client_id` in
# platform/kube-prometheus-stack/values.yaml to match what actually exists.
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-oidc
  namespace: monitoring
type: Opaque
stringData:
  GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET: PUT_THE_KEYCLOAK_GRAFANA_CLIENT_SECRET_HERE
