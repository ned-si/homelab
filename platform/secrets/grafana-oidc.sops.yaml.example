# TEMPLATE -- copy to grafana-oidc.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/grafana-oidc.sops.yaml
#
# The client secret of the `grafana` OIDC client (homelab realm). The key
# name matters: grafana.ini reads `$__env{GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET}`
# and the chart injects this Secret with envFrom. `client_id` in
# platform/kube-prometheus-stack/values.yaml must match the client.
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-oidc
  namespace: monitoring
type: Opaque
stringData:
  GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET: PUT_THE_KEYCLOAK_GRAFANA_CLIENT_SECRET_HERE
