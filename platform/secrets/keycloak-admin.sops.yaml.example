# TEMPLATE -- copy to keycloak-admin.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/keycloak-admin.sops.yaml
#
# Generate: openssl rand -base64 30
#
# Bootstraps the FIRST admin of an empty database only; on an existing one,
# rotate the password in the admin console.
---
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-admin
  namespace: keycloak
type: Opaque
stringData:
  username: admin
  password: PUT_A_FRESHLY_GENERATED_PASSWORD_HERE
