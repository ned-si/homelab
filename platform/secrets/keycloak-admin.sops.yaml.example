# TEMPLATE -- copy to keycloak-admin.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/keycloak-admin.sops.yaml
#
# The previous value of this password was committed in plaintext in
# kubernetes/applications/keycloak/keycloak.yaml as KC_BOOTSTRAP_ADMIN_PASSWORD.
# It is compromised. Generate a fresh one:
#
#     openssl rand -base64 30
#
# This only bootstraps the FIRST admin account on an empty database. If Keycloak
# already has an admin user, changing this has no effect -- you must rotate the
# password in the Keycloak admin console instead.
---
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-admin
  namespace: keycloak
type: Opaque
stringData:
  username: admin
  password: PUT_A_FRESHLY_GENERATED_PASSWORD_HERE
