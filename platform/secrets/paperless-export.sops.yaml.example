# TEMPLATE -- copy to paperless-export.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/paperless-export.sops.yaml
#
# The copy of the Paperless export passphrase for the monthly restore test
# (platform/backup-verify/restore-paperless.yaml, `document_importer
# --passphrase`). The same value as apps/secrets/paperless-export.sops.yaml;
# change both together.
#
# secrets.local.env key: PAPERLESS_EXPORT_PASSPHRASE.
---
apiVersion: v1
kind: Secret
metadata:
  name: paperless-export
  namespace: backup-verify
type: Opaque
stringData:
  passphrase: PUT_THE_PAPERLESS_EXPORT_PASSPHRASE_HERE
