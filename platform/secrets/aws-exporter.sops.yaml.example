# TEMPLATE -- copy to aws-exporter.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/aws-exporter.sops.yaml
#
# The read-only homelab-metrics-reader access key (bootstrap/aws-backup), for
# YACE and aws-cost-exporter (platform/aws-exporter). Key names are the ones
# the YACE chart expects.
#
#   scripts/tofu.sh bootstrap/aws-backup output -raw metrics_access_key_id
#   scripts/tofu.sh bootstrap/aws-backup output -raw metrics_secret_access_key
#
# Or put both in secrets.local.env as AWS_METRICS_ACCESS_KEY_ID and
# AWS_METRICS_SECRET_ACCESS_KEY and run scripts/seal-secrets-from-env.sh.
---
apiVersion: v1
kind: Secret
metadata:
  name: aws-exporter
  namespace: monitoring
type: Opaque
stringData:
  access_key: PUT_THE_METRICS_ACCESS_KEY_HERE
  secret_key: PUT_THE_METRICS_SECRET_KEY_HERE
