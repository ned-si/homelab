# TEMPLATE -- copy to tailscale-operator.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/tailscale-operator.sops.yaml
# (or scripts/seal-secrets-from-env.sh, from TAILSCALE_OAUTH_CLIENT_ID and
# TAILSCALE_OAUTH_CLIENT_SECRET in secrets.local.env).
#
# The OAuth client of the Tailscale operator (admin console, Settings ->
# Trust credentials): scopes Devices Core write, Auth Keys write, Services
# write, tag tag:k8s-operator. The chart mounts this Secret at /oauth; its
# name must be `<fullname>-oauth` (docs/remote-access.md).
---
apiVersion: v1
kind: Secret
metadata:
  name: operator-oauth
  namespace: tailscale
type: Opaque
stringData:
  client_id: PUT_THE_TAILSCALE_OAUTH_CLIENT_ID_HERE
  client_secret: PUT_THE_TAILSCALE_OAUTH_CLIENT_SECRET_HERE
