# TEMPLATE -- copy to alertmanager-notify.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/alertmanager-notify.sops.yaml
#
# ###########################################################################
# # ORDER MATTERS: SEAL THE FILE FIRST, LIST IT IN ./secret-generator.yaml
# # SECOND.
# #
# # KSOPS resolves every file in that list at render time, so a reference to a
# # file that does not exist fails the WHOLE `secrets-platform` Application --
# # taking the Keycloak admin, the Grafana OIDC client and the S3 backup
# # credential down with it.
# #
# # Both steps are done: `- ./alertmanager-notify.sops.yaml` is in the generator
# # and the sealed file exists. If you ever delete the sealed file, remove that
# # line in the same commit.
# ###########################################################################
#
# ###########################################################################
# # THIS SECRET IS WHAT TURNS THE ALERT RULES INTO NOTIFICATIONS.
# #
# # Before it existed, Alertmanager ran with no receivers: every rule in
# # platform/backup-verify/alerts.yaml and
# # platform/kube-prometheus-stack/routes/alerts.yaml rendered to a web page
# # nobody opens.
# #
# # The Alertmanager pod will NOT START until this Secret exists, because the
# # operator mounts it as a volume. That is deliberate. The alternative --
# # Alertmanager starting and failing every delivery -- looks identical from the
# # outside to the problem this replaces.
# ###########################################################################
#
# HOW IT IS CONSUMED
#
# `alertmanager.alertmanagerSpec.secrets: [alertmanager-notify]` in
# platform/kube-prometheus-stack/values.yaml makes the Prometheus Operator mount
# this Secret at:
#
#     /etc/alertmanager/secrets/alertmanager-notify/<key>
#
# one file per key. The Alertmanager config then uses the `*_file` forms
# (`token_file`, `user_key_file`, `url_file`) so no credential and nothing
# identifying the owner's devices appears in git -- not even the destination.
#
# The key NAMES are load-bearing: they become filenames, and the paths are
# hard-coded in values.yaml. Renaming a key here without changing values.yaml
# gives an Alertmanager that starts and then fails every send.
#
# ---------------------------------------------------------------------------
# WHERE THE THREE VALUES COME FROM
#
# 1. pushover-token  -- an APPLICATION token.
#      https://pushover.net/apps/build
#      Name it something like `homelab-alertmanager`. Type: Application.
#      This is per-application, so revoking it kills alerts and nothing else.
#
# 2. pushover-user-key -- YOUR user key, shown on https://pushover.net after
#      login. This is the "which devices" half. It is not rotatable without
#      changing every application you use, so treat it as long-lived.
#
#      Pushover is a paid one-off (about $5 per platform) after the trial. That
#      is the price of the property that made it the choice here: both halves
#      are file-sourced, so nothing site-specific lands in git. See the comment
#      block in platform/kube-prometheus-stack/values.yaml for the alternatives
#      that were rejected and the exact edit to switch to Telegram instead.
#
# 3. heartbeat-url -- a DEAD-MAN'S SWITCH ping URL.
#
#      This is the single most valuable line in this file. Alertmanager sends
#      the always-firing `Watchdog` alert to it every 5 minutes. The provider
#      notifies you when the pings STOP -- i.e. when Prometheus, Alertmanager,
#      the node they run on, or the house's internet has died. Every other alert
#      in this repository fails silently in exactly that scenario.
#
#      Free options, no server:
#        healthchecks.io  -> create a check, copy its "Ping URL"
#                            (https://hc-ping.com/<uuid>)
#        Better Stack     -> Heartbeats -> copy the URL
#
#      SET THE GRACE PERIOD TO 15-20 MINUTES. Alertmanager's repeat_interval
#      for this route is 5m, so a grace shorter than ~11m reports a normal
#      quiet period as an outage and you will mute it within a week.
#
#      Point the provider's notification at an address that does NOT depend on
#      this cluster. An email routed through something running here cannot tell
#      you that this is down.
# ---------------------------------------------------------------------------
#
# ONE NAMESPACE ONLY. Alertmanager runs in `monitoring`, and unlike `s3-backup`
# this credential has no reason to exist anywhere else.
---
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-notify
  namespace: monitoring
type: Opaque
stringData:
  # Pushover application token -- https://pushover.net/apps/build
  pushover-token: PUT_THE_PUSHOVER_APPLICATION_TOKEN_HERE
  # Pushover user key -- shown on https://pushover.net after login.
  pushover-user-key: PUT_THE_PUSHOVER_USER_KEY_HERE
  # Dead-man's switch ping URL. Grace period 15-20m at the provider.
  # e.g. https://hc-ping.com/00000000-0000-0000-0000-000000000000
  heartbeat-url: PUT_THE_HEARTBEAT_PING_URL_HERE
