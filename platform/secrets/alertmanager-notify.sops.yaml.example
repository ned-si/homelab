# TEMPLATE -- copy to alertmanager-notify.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/alertmanager-notify.sops.yaml
#
# Seal the file before listing it in ./secret-generator.yaml: a missing file
# fails the whole `secrets-platform` Application.
#
# The operator mounts this Secret at
# /etc/alertmanager/secrets/alertmanager-notify/<key> and the config reads it
# with `url_file`, so the key names are load-bearing (values.yaml). The
# Alertmanager pod does not start without it.
#
#   ntfy-url        https://ntfy.sh/<topic>. The topic is the credential:
#                   echo "homelab-$(LC_ALL=C tr -dc 'a-z0-9' </dev/urandom | head -c 32)"
#                   With seal-secrets-from-env.sh, set NTFY_TOPIC only.
#   ntfy-guard-url  ntfy-url plus `-guard`.
#   heartbeat-url   the dead-man's switch (healthchecks.io ping URL) that
#                   Watchdog pings every 5 minutes. Grace period 15-20
#                   minutes; notify the same ntfy topic.
---
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-notify
  namespace: monitoring
type: Opaque
stringData:
  # ntfy.sh topic URL: https://ntfy.sh/<long random topic>
  ntfy-url: "https://ntfy.sh/PUT_THE_NTFY_TOPIC_HERE"
  # The same topic plus -guard: the node and NAS alerts at any hour, read by
  # the auto-rollback outage guard. Nobody subscribes to it.
  ntfy-guard-url: "https://ntfy.sh/PUT_THE_NTFY_TOPIC_HERE-guard"
  # Dead-man's switch ping URL. Grace period 15-20m at the provider.
  # e.g. https://hc-ping.com/00000000-0000-0000-0000-000000000000
  heartbeat-url: PUT_THE_HEARTBEAT_PING_URL_HERE
