# TEMPLATE -- copy to keycloak-smtp.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/keycloak-smtp.sops.yaml
# (or scripts/seal-secrets-from-env.sh, from HOMELAB_SMTP_USER and
# HOMELAB_SMTP_TOKEN in secrets.local.env).
#
# The SMTP login of the `homelab` realm (platform.conf `smtp`): a Proton SMTP
# token of the sender address (Proton, Settings, IMAP/SMTP, SMTP tokens). The
# keycloak-realm-settings Job writes it to the realm; SMTP_USER must equal the
# `from` of platform.conf.
---
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-smtp
  namespace: keycloak
type: Opaque
stringData:
  SMTP_USER: "PUT_THE_SMTP_USER_HERE"
  SMTP_PASSWORD: "PUT_THE_PROTON_SMTP_TOKEN_HERE"
