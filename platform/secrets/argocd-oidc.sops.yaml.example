# TEMPLATE -- copy to argocd-oidc.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/argocd-oidc.sops.yaml
# (or scripts/seal-secrets-from-env.sh, from ARGOCD_OIDC_CLIENT_SECRET in
# secrets.local.env).
#
# The secret of the Keycloak client `argocd`, read by `oidc.config` in
# bootstrap/argocd-values.yaml as `$argocd-oidc-keycloak:clientSecret` (needs
# the label `app.kubernetes.io/part-of: argocd`). Not a key of argocd-secret:
# chart upgrades rewrite that Secret.
---
apiVersion: v1
kind: Secret
metadata:
  name: argocd-oidc-keycloak
  namespace: argo
  labels:
    app.kubernetes.io/part-of: argocd
type: Opaque
stringData:
  clientSecret: PUT_THE_KEYCLOAK_ARGOCD_CLIENT_SECRET_HERE
