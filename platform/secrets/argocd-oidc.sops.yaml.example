# TEMPLATE -- copy to argocd-oidc.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/argocd-oidc.sops.yaml
# (or scripts/seal-secrets-from-env.sh, from ARGOCD_OIDC_CLIENT_SECRET in
# secrets.local.env).
#
# The secret of the Keycloak client `argocd` (homelab realm, Clients, argocd,
# Credentials). Keycloak holds the value; this Secret must hold the same one.
#
# HOW IT IS CONSUMED
#
# `oidc.config` in bootstrap/argocd-values.yaml reads it as
# `$argocd-oidc-keycloak:clientSecret`. Argo CD resolves a `$<secret>:<key>`
# reference only in a Secret of its namespace labelled
# `app.kubernetes.io/part-of: argocd`. It is not a key of the chart-managed
# argocd-secret on purpose: a chart upgrade rewrote that Secret and dropped
# the hand-added key, which broke the login.
---
apiVersion: v1
kind: Secret
metadata:
  name: argocd-oidc-keycloak
  namespace: argo
  labels:
    app.kubernetes.io/part-of: argocd
type: Opaque
stringData:
  clientSecret: PUT_THE_KEYCLOAK_ARGOCD_CLIENT_SECRET_HERE
