# TEMPLATE -- copy to s3-backup.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/s3-backup.sops.yaml
#
# ONE credential, replicated into every namespace that backs anything up. It is
# the same Secret name and the same keys everywhere, so the backup manifests do
# not each need their own reference.
#
# ---------------------------------------------------------------------------
# PROVIDER: AWS S3, eu-central-1, created by bootstrap/aws-backup/.
#
# The bulk of the data (restic pack files) sits in Glacier Instant Retrieval at
# roughly a sixth of Standard's price, while Postgres/barman stays in Standard
# because WAL is small-object churn that archive classes penalise. Full reasoning,
# including why NOT Deep Archive, is in docs/backups.md.
#
# Other S3-compatible stores work unchanged -- Backblaze B2 is cheaper per GB,
# Cloudflare R2 has zero egress -- but AWS was chosen partly BECAUSE the
# verification strategy leans on it: a full annual restore drill runs on an EC2
# instance in the bucket's own region, where S3 -> EC2 traffic is free. That is
# what makes reading the entire backup back affordable.
#
# To repoint everything at a different provider:
#     task backup:set-target -- <bucket> <region> [endpoint-url]
#
# ---------------------------------------------------------------------------
# THE CREDENTIAL IS SCOPED, AND CANNOT PERMANENTLY DELETE
#
# bootstrap/aws-backup/ creates an IAM user restricted to this bucket, which can
# put/get/delete objects -- restic prunes and barman enforces retention, so
# delete is required -- but carries an explicit Deny on DeleteObjectVersion,
# PutBucketVersioning, PutLifecycleConfiguration and DeleteBucket.
#
# With versioning enabled, that means a DeleteObject only writes a delete marker
# and the previous version survives 30 days. A compromised backup credential can
# make a mess; it cannot destroy the backups. Deny beats Allow in IAM, so this
# holds even if a broader policy is attached later.
#
# ---------------------------------------------------------------------------
# NINE copies below, one per namespace that backs something up or verifies a
# backup. Kubernetes Secrets are namespaced and there is no built-in replication;
# a reflector controller could do this, but that is another moving part for nine
# near-identical objects.
#
# `monitoring` is here for Grafana's backup CronJob
# (platform/kube-prometheus-stack/routes/grafana-backup.yaml).
#
# ###########################################################################
# # `backup-verify` WAS MISSING, AND THAT WAS A REAL BUG.
# #
# # This template previously had seven copies and `backup-verify` was not one of
# # them -- but platform/backup-verify/restore-files.yaml does
# # `envFrom: secretRef: name: s3-backup` in the `backup-verify` namespace, and
# # platform/backup-verify/restore-postgres.yaml references
# # `name: s3-backup` for the barman credentials of the throwaway cluster.
# #
# # So the entire restore-verification pipeline -- the thing that proves the
# # backups are real -- could never have run. The file verifier's pod would
# # have failed to start with CreateContainerConfigError, and the Postgres
# # verifier's throwaway Cluster would have failed to reach the object store.
# #
# # Both would have looked like a backup problem rather than a missing Secret.
# ###########################################################################
---
apiVersion: v1
kind: Secret
metadata:
  name: s3-backup
  namespace: immich
type: Opaque
stringData:
  # Barman reads these two key names.
  ACCESS_KEY_ID: PUT_THE_S3_ACCESS_KEY_HERE
  ACCESS_SECRET_KEY: PUT_THE_S3_SECRET_KEY_HERE
  # restic reads these. Same values, different names -- restic and barman
  # disagree about conventions and neither is configurable.
  AWS_ACCESS_KEY_ID: PUT_THE_S3_ACCESS_KEY_HERE
  AWS_SECRET_ACCESS_KEY: PUT_THE_S3_SECRET_KEY_HERE
  # restic derives the signing region from this. Must match the bucket.
  AWS_DEFAULT_REGION: eu-central-1
  # Encrypts the restic repository. NOT the same thing as the S3 credential:
  # without it the backups are unreadable even to you.
  # Generate:  openssl rand -base64 48
  # BACK THIS UP SEPARATELY, alongside the age key.
  RESTIC_PASSWORD: PUT_A_GENERATED_RESTIC_REPOSITORY_PASSWORD_HERE
---
