# TEMPLATE -- copy to s3-backup.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/s3-backup.sops.yaml
#
# ONE credential, the same Secret name and keys in every namespace that backs
# something up (nine copies below; no replication controller for that).
# Bucket, region and storage classes: bootstrap/aws-backup/, docs/backups.md.
# Another provider: task backup:set-target -- <bucket> <region> [endpoint-url]
#
# The IAM user is limited to the bucket and denied DeleteObjectVersion,
# PutBucketVersioning, PutLifecycleConfiguration and DeleteBucket. With
# versioning, a delete only writes a marker for 30 days, so a leaked key
# cannot destroy the backups.
---
apiVersion: v1
kind: Secret
metadata:
  name: s3-backup
  namespace: immich
type: Opaque
stringData:
  # Barman reads these two key names.
  ACCESS_KEY_ID: PUT_THE_S3_ACCESS_KEY_HERE
  ACCESS_SECRET_KEY: PUT_THE_S3_SECRET_KEY_HERE
  # restic reads these. Same values, different names -- restic and barman
  # disagree about conventions and neither is configurable.
  AWS_ACCESS_KEY_ID: PUT_THE_S3_ACCESS_KEY_HERE
  AWS_SECRET_ACCESS_KEY: PUT_THE_S3_SECRET_KEY_HERE
  # restic derives the signing region from this. Must match the bucket.
  AWS_DEFAULT_REGION: eu-central-1
  # Encrypts the restic repository. NOT the same thing as the S3 credential:
  # without it the backups are unreadable even to you.
  # Generate:  openssl rand -base64 48
  # BACK THIS UP SEPARATELY, alongside the age key.
  RESTIC_PASSWORD: PUT_A_GENERATED_RESTIC_REPOSITORY_PASSWORD_HERE
---
