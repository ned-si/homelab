apiVersion: v1
kind: Secret
metadata:
  name: s3-backup
  namespace: monitoring
type: Opaque
stringData:
  # Grafana's backup uses restic only; the ACCESS_KEY_ID/ACCESS_SECRET_KEY pair
  # is barman's spelling and nothing in `monitoring` speaks barman. Both are
  # kept anyway so all nine copies are byte-identical apart from the namespace
  # -- a Secret that differs per namespace for no reason is a Secret someone
  # eventually fills in wrong.
  ACCESS_KEY_ID: PUT_THE_S3_ACCESS_KEY_HERE
  ACCESS_SECRET_KEY: PUT_THE_S3_SECRET_KEY_HERE
  AWS_ACCESS_KEY_ID: PUT_THE_S3_ACCESS_KEY_HERE
  AWS_SECRET_ACCESS_KEY: PUT_THE_S3_SECRET_KEY_HERE
  AWS_DEFAULT_REGION: eu-central-1
  RESTIC_PASSWORD: PUT_A_GENERATED_RESTIC_REPOSITORY_PASSWORD_HERE
---
# The verifier's namespace. Without this the restore drills cannot start at all
# -- see the block at the top of this file.
#
# WORTH USING THE READ-ONLY CREDENTIAL HERE. bootstrap/aws-backup/ creates a
# second IAM user, `<bucket>-verifier`, which can read objects and write only
# under `*/locks/*` (restic insists on a lock file even for `check` and
# `restore`). Putting the WRITER key here would mean a drill gone wrong could
# damage the backup it is testing.
#
# `tofu output -raw verify_access_key_id` / `verify_secret_access_key`.
apiVersion: v1
kind: Secret
metadata:
  name: s3-backup
  namespace: backup-verify
type: Opaque
stringData:
  # Barman, for the throwaway recovery Cluster in restore-postgres.yaml.
  ACCESS_KEY_ID: PUT_THE_S3_VERIFIER_ACCESS_KEY_HERE
  ACCESS_SECRET_KEY: PUT_THE_S3_VERIFIER_SECRET_KEY_HERE
  # restic, for restore-files.yaml.
  AWS_ACCESS_KEY_ID: PUT_THE_S3_VERIFIER_ACCESS_KEY_HERE
  AWS_SECRET_ACCESS_KEY: PUT_THE_S3_VERIFIER_SECRET_KEY_HERE
  AWS_DEFAULT_REGION: eu-central-1
  # MUST be byte-identical to the writer's RESTIC_PASSWORD. It is not an access
  # credential -- it is the repository encryption key. A different value here
  # does not produce a permissions error, it produces "wrong password or no key
  # found", which reads like a corrupt repository.
  RESTIC_PASSWORD: PUT_A_GENERATED_RESTIC_REPOSITORY_PASSWORD_HERE
