# TEMPLATE -- copy to s3-backup.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/s3-backup.sops.yaml
#
# ONE credential, replicated into every namespace that backs anything up. It is
# the same Secret name and the same keys everywhere, so the backup manifests do
# not each need their own reference.
#
# ---------------------------------------------------------------------------
# CHOOSING A PROVIDER
#
# Any S3-compatible object store works. What matters for this use case:
#
#   Backblaze B2      cheapest for the ~2TB Immich library; S3-compatible
#                     endpoint is https://s3.<region>.backblazeb2.com
#   Cloudflare R2     zero egress fees, which makes RESTORE free. Endpoint is
#                     https://<account>.r2.cloudflarestorage.com
#   AWS S3            most expensive here, mainly because egress is charged and
#                     a restore of the photo library means egressing 2TB
#   Wasabi / Storj    also fine
#
# For a 2TB library that you hope never to restore but must be able to,
# R2's free egress is worth more than B2's slightly lower storage price.
#
# ---------------------------------------------------------------------------
# SCOPE THE CREDENTIAL
#
# Create a dedicated key with access to the backup bucket ONLY, and enable
# object-lock / versioning on the bucket if the provider supports it. A backup
# credential that can delete its own bucket is not a backup credential -- it is
# ransomware's first target. Restic and Barman both only ever need
# read/write/list within their prefix; neither needs DeleteBucket.
#
# ---------------------------------------------------------------------------
# Six copies below, one per namespace. Kubernetes Secrets are namespaced and
# there is no built-in replication; a reflector controller could do this, but
# that is another moving part for six near-identical objects.
---
apiVersion: v1
kind: Secret
metadata:
  name: s3-backup
  namespace: immich
type: Opaque
stringData:
  # Barman reads these two key names.
  ACCESS_KEY_ID: PUT_THE_S3_ACCESS_KEY_HERE
  ACCESS_SECRET_KEY: PUT_THE_S3_SECRET_KEY_HERE
  # restic reads these. Same values, different names -- restic and barman
  # disagree about conventions and neither is configurable.
  AWS_ACCESS_KEY_ID: PUT_THE_S3_ACCESS_KEY_HERE
  AWS_SECRET_ACCESS_KEY: PUT_THE_S3_SECRET_KEY_HERE
  # Encrypts the restic repository. NOT the same thing as the S3 credential:
  # without it the backups are unreadable even to you.
  # Generate:  openssl rand -base64 48
  # BACK THIS UP SEPARATELY, alongside the age key.
  RESTIC_PASSWORD: PUT_A_GENERATED_RESTIC_REPOSITORY_PASSWORD_HERE
---
