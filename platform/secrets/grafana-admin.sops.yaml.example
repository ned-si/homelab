# TEMPLATE -- copy to grafana-admin.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/grafana-admin.sops.yaml
# (or scripts/seal-secrets-from-env.sh, from GRAFANA_ADMIN_PASSWORD in
# secrets.local.env).
#
# Grafana's built-in admin, the break-glass login when Keycloak is down
# (docs/runbooks/grafana-break-glass.md). Read by the chart through
# `grafana.admin.existingSecret` in platform/kube-prometheus-stack/values.yaml:
# GF_SECURITY_ADMIN_USER / GF_SECURITY_ADMIN_PASSWORD of the grafana container
# and the dashboard and datasource sidecars' reload login.
#
# Grafana applies admin-password only when grafana.db is created. On an
# existing database, set it with `grafana cli admin reset-admin-password` as
# in the runbook, or the login keeps the old password.
#
#   admin-user      admin
#   admin-password  Generate: openssl rand -base64 33 | tr -d '\n=+/' | cut -c1-40
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin
  namespace: monitoring
type: Opaque
stringData:
  admin-user: "admin"
  admin-password: "PUT_THE_GRAFANA_ADMIN_PASSWORD_HERE"
