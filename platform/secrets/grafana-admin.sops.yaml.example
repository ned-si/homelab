# TEMPLATE -- copy to grafana-admin.sops.yaml, fill in, then:
#     task secrets:seal -- platform/secrets/grafana-admin.sops.yaml
# (or scripts/seal-secrets-from-env.sh, from GRAFANA_ADMIN_PASSWORD in
# secrets.local.env).
#
# Grafana's built-in admin, the break-glass login
# (docs/runbooks/grafana-break-glass.md). Applied only when grafana.db is
# created; on an existing database use `grafana cli admin
# reset-admin-password`.
#
#   admin-user      admin
#   admin-password  Generate: openssl rand -base64 33 | tr -d '\n=+/' | cut -c1-40
---
apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin
  namespace: monitoring
type: Opaque
stringData:
  admin-user: "admin"
  admin-password: "PUT_THE_GRAFANA_ADMIN_PASSWORD_HERE"
