{
  "uid": "homelab-automation",
  "title": "Homelab / Automation",
  "description": "The automated history of the homelab: merges, auto-rollbacks, syncs, drift runs, backups, upgrades, silences and the alerts automation handles.",
  "tags": [
    "homelab",
    "automation"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "5m",
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "INFO alert",
        "enable": true,
        "iconColor": "blue",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "ALERTS{alertstate=\"firing\", action=\"auto\"}",
        "step": "1m",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{namespace}} {{name}}{{app}}{{node}}",
        "tagKeys": "alertname"
      },
      {
        "name": "PAGE alert",
        "enable": true,
        "iconColor": "red",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "ALERTS{alertstate=\"firing\", action=\"human\"}",
        "step": "1m",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{namespace}} {{name}}{{app}}{{node}}",
        "tagKeys": "alertname"
      },
      {
        "name": "Argo CD failure",
        "enable": true,
        "iconColor": "orange",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "ALERTS{alertname=~\"ArgoCDAppDegraded|ArgoCDSyncFailed\", alertstate=\"firing\"}",
        "step": "1m",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{name}}",
        "tagKeys": "name"
      },
      {
        "name": "Argo CD recovery sync (auto-rollback or fix)",
        "enable": true,
        "iconColor": "green",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "(sum by (name) (increase(argocd_app_sync_total{phase=\"Succeeded\"}[5m])) > 0) and on (name) (max by (name) (max_over_time(ALERTS{alertname=~\"ArgoCDAppDegraded|ArgoCDSyncFailed\", alertstate=\"firing\"}[1h])))",
        "step": "5m",
        "titleFormat": "Recovery sync",
        "textFormat": "{{name}}: a successful sync after a failure in the previous hour",
        "tagKeys": "name"
      }
    ]
  },
  "links": [
    {
      "title": "Homelab",
      "type": "dashboards",
      "tags": [
        "homelab"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "type": "text",
      "id": 1,
      "title": "Automation",
      "options": {
        "mode": "markdown",
        "content": "What ran on its own, newest first. Nothing here notifies; a notification means a person has to act ([paging policy](https://github.com/ned-si/homelab/blob/main/docs/sre.md#paging)). [Overview](/d/homelab-overview) \u00b7 [CI-CD](/d/homelab-cicd) \u00b7 [Data protection](/d/homelab-data-protection)"
      },
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Merged pull requests, 7 d",
      "description": "Every merged pull request: Renovate, auto-rollback reverts and the rest.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(automation:event:timestamp_seconds{source=\"github\", result=\"merged\"} > time() - 7 * 86400)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 2
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Renovate automerges, 7 d",
      "description": "Renovate pull requests merged on green CI.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(automation:event:timestamp_seconds{kind=\"renovate\"} > time() - 7 * 86400)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 2
      }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Auto-rollback reverts, 7 d",
      "description": "Revert pull requests auto-rollback merged (label auto-rollback).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(automation:event:timestamp_seconds{kind=\"auto-rollback\", result=\"merged\"} > time() - 7 * 86400)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 2
      }
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Failed automation, 7 d",
      "description": "Events whose result is failed or error: a run, a sync, a backup, an upgrade. A failure that needs a person also pages.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(automation:event:timestamp_seconds{result=~\"failed|failure|error|revert failed|manual: failed\"} > time() - 7 * 86400)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "center"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 2
      }
    },
    {
      "type": "table",
      "id": 6,
      "title": "Timeline: everything automation did, last 7 days",
      "description": "Newest first. Merged pull requests (Renovate, auto-rollback reverts, the rest), auto-rollback and tofu runs, Argo CD syncs, backup and restore-test Jobs, CNPG base backups, tuppr upgrades and maintenance silences. Tap a row's What to open its pull request, run, commit or dashboard. Recording rule automation:event:timestamp_seconds (platform/kube-prometheus-stack/routes/automation.yaml).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort_desc((automation:event:timestamp_seconds > time() - 7 * 86400) * 1000)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "When"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Kind"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "App"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "What"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open",
                    "url": "${__data.fields.url}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Result"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 120
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^(failed|failure|error|revert failed|manual: failed)$",
                      "result": {
                        "color": "red",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^(reverted|drift corrected|not reverted|manual: .*)$",
                      "result": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^(active|pending|Upgrading|HealthChecking)$",
                      "result": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": ".*",
                      "result": {
                        "color": "green",
                        "index": 3
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "url"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "source"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": [
          {
            "displayName": "When",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Value",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "Value": 0,
              "kind": 1,
              "app": 2,
              "what": 3,
              "result": 4,
              "url": 5,
              "source": 6
            },
            "renameByName": {
              "Value": "When",
              "kind": "Kind",
              "app": "App",
              "what": "What",
              "result": "Result"
            }
          }
        }
      ],
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Activity per hour",
      "description": "Argo CD syncs per hour, and how many alerts fire by class. The markers are the alerts: blue INFO (automation handles it), red PAGE (a person has to act), and the Argo CD failure and recovery sync of an auto-rollback.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(argocd_app_sync_total{phase=\"Succeeded\"}[1h]))",
          "refId": "A",
          "legendFormat": "Argo CD syncs"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(argocd_app_sync_total{phase=~\"Error|Failed\"}[1h]))",
          "refId": "B",
          "legendFormat": "Argo CD failed syncs"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(ALERTS{alertstate=\"firing\", action=\"auto\"}) or vector(0)",
          "refId": "C",
          "legendFormat": "INFO alerts firing"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(ALERTS{alertstate=\"firing\", action=\"human\"}) or vector(0)",
          "refId": "D",
          "legendFormat": "PAGE alerts firing"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Argo CD failed syncs"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "INFO alerts firing"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "PAGE alerts firing"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      }
    },
    {
      "type": "table",
      "id": 8,
      "title": "INFO alerts firing now",
      "description": "Alerts labelled action: auto: automation handles them, so they notify nobody (docs/sre.md \"Paging\"). Since: when each became active; an alert without a for: duration (ArgoCDSyncFailed) shows now.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort_desc((max by (alertname, namespace, name, app, node) (ALERTS_FOR_STATE{action=\"auto\"}) and on (alertname, namespace, name, app, node) max by (alertname, namespace, name, app, node) (ALERTS{alertstate=\"firing\", action=\"auto\"}) or max by (alertname, namespace, name, app, node) (timestamp(ALERTS{alertstate=\"firing\", action=\"auto\"}))) * 1000)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Since"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeFromNow"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "Value": 0,
              "alertname": 1
            },
            "renameByName": {
              "Value": "Since"
            }
          }
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 34
      }
    },
    {
      "type": "bargauge",
      "id": 9,
      "title": "Argo CD syncs per application, 24 h",
      "description": "Successful syncs in the last 24 hours (argocd_app_sync_total).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort_desc(sum by (name) (increase(argocd_app_sync_total{phase=\"Succeeded\"}[24h])) > 0)",
          "refId": "A",
          "legendFormat": "{{name}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 34
      }
    }
  ]
}
