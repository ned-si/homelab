        "h": 8,
        "w": 12,
        "x": 12,
        "y": 47
      }
    },
    {
      "id": 20,
      "type": "row",
      "title": "DNS (CoreDNS)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 55
      },
      "panels": []
    },
    {
      "id": 21,
