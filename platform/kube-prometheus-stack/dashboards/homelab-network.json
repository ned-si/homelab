      "title": "SERVFAIL and NXDOMAIN share",
      "description": "Share of CoreDNS responses that are SERVFAIL (upstream or plugin failure) or NXDOMAIN (name does not exist; search-path lookups make some normal).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(coredns_dns_responses_total{rcode=\"SERVFAIL\"}[5m])) / sum(rate(coredns_dns_responses_total[5m]))",
          "refId": "A",
          "legendFormat": "SERVFAIL"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(coredns_dns_responses_total{rcode=\"NXDOMAIN\"}[5m])) / sum(rate(coredns_dns_responses_total[5m]))",
          "refId": "B",
          "legendFormat": "NXDOMAIN"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
