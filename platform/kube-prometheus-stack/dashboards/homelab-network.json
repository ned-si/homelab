      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 39
      }
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Drops by reason and direction (datapath)",
      "description": "cilium_drop_count_total: every drop the datapath counts, including those Hubble does not export as flows.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (reason, direction) (rate(cilium_drop_count_total[5m]))",
          "refId": "A",
          "legendFormat": "{{reason}} {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
