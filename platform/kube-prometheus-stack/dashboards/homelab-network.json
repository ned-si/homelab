    {
      "id": 18,
      "type": "timeseries",
      "title": "Drops by destination (top 10)",
      "description": "Dropped packets per second by destination namespace or identity.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, sum by (destination) (rate(hubble_drop_total[5m])))",
          "refId": "A",
          "legendFormat": "{{destination}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
