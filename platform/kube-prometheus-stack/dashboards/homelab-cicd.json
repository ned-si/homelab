{
  "uid": "homelab-cicd",
  "title": "Homelab / CI-CD",
  "description": "GitHub Actions results and durations, pull requests and Renovate, auto-rollbacks, and Argo CD sync state and last deploy per application.",
  "tags": [
    "homelab",
    "cicd"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "5m",
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "GitHub Actions",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Latest run on main",
      "description": "github_workflow_last_success{scope=\"main\"}: the conclusion of the latest completed run on main, per workflow.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (workflow) (github_workflow_last_success{scope=\"main\"})",
          "refId": "A",
          "legendFormat": "{{workflow}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "failed",
                  "color": "red"
                },
                "1": {
                  "text": "passed",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "bargauge",
      "title": "Success rate (last 30 runs, 30 days)",
      "description": "Successful runs over completed runs; skipped and cancelled runs are left out.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (workflow) (github_workflow_runs{conclusion=\"success\"}) / sum by (workflow) (github_workflow_runs{conclusion!~\"skipped|cancelled\"})",
          "refId": "A",
          "legendFormat": "{{workflow}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "id": 3,
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "bargauge",
      "title": "Duration of the latest run",
      "description": "Latest completed run of each workflow, any branch.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (workflow) (github_workflow_last_run_duration_seconds{scope=\"any\"})",
          "refId": "A",
          "legendFormat": "{{workflow}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "id": 4,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      }
    },
    {
      "type": "bargauge",
      "title": "Mean duration of successful runs",
      "description": "Over the last 30 runs of each workflow.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (workflow) (github_workflow_success_duration_seconds_avg)",
          "refId": "A",
          "legendFormat": "{{workflow}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "id": 5,
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Pull requests and Renovate",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Open pull requests",
      "description": "Renovate and everything else.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "github_pull_requests_open",
          "refId": "A",
          "legendFormat": "{{author}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 7,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 15
      }
    },
    {
      "type": "stat",
      "title": "Renovate automerge rate (30 d)",
      "description": "Renovate PRs merged over Renovate PRs closed in the last 30 days. Everything automerges on green CI, so a PR closed unmerged was superseded or failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(github_pull_requests_closed_30d{author=\"renovate\",state=\"merged\"}) / sum(github_pull_requests_closed_30d{author=\"renovate\"})",
          "refId": "A",
          "legendFormat": "automerged",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 8,
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 6,
        "y": 15
      }
    },
    {
      "type": "stat",
      "title": "Renovate lead time (30 d)",
      "description": "Mean time from a Renovate PR opening to its merge.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "github_renovate_merge_lead_time_seconds_avg_30d",
          "refId": "A",
          "legendFormat": "mean",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 86400
              },
              {
                "color": "red",
                "value": 604800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 9,
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 11,
        "y": 15
      }
    },
    {
      "type": "stat",
      "title": "Auto-rollbacks",
      "description": "Pull requests labelled auto-rollback: closed in the last 30 days, and open now.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "github_auto_rollback_pull_requests_30d",
          "refId": "A",
          "legendFormat": "30 d",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "github_auto_rollback_pull_requests_open",
          "refId": "B",
          "legendFormat": "open",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 10,
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 15
      }
    },
    {
      "type": "stat",
      "title": "Exporter data age",
      "description": "Time since github-exporter last read GitHub (every 15 minutes).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - max(github_exporter_last_success_timestamp_seconds)",
          "refId": "A",
          "legendFormat": "age",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1800
              },
              {
                "color": "red",
                "value": 3600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 11,
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 15
      }
    },
    {
      "type": "table",
      "title": "Open pull requests by age",
      "description": "Every open pull request; Renovate's are the out-of-date components waiting for CI or a fix.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort_desc(max by (number, branch, author, draft) (github_pull_request_open_age_seconds))",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "age"
            }
          }
        }
      ],
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 14,
        "x": 0,
        "y": 20
      }
    },
    {
      "type": "bargauge",
      "title": "Renovate Dependency Dashboard",
      "description": "Entries per section of the Dependency Dashboard issue: updates awaiting a schedule, rate-limited, pending approval, open, or ignored/blocked.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (section) (github_renovate_dashboard_entries)",
          "refId": "A",
          "legendFormat": "{{section}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      },
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 14,
        "y": 20
      }
    },
    {
      "id": 14,
      "type": "row",
      "title": "Argo CD",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Applications",
      "description": "argocd_app_info: Synced and Healthy against all.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(argocd_app_info{sync_status=\"Synced\",health_status=\"Healthy\"})",
          "refId": "A",
          "legendFormat": "Synced+Healthy",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(argocd_app_info)",
          "refId": "B",
          "legendFormat": "all",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 15,
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 29
      }
    },
    {
      "type": "table",
      "title": "Applications not Synced or not Healthy",
      "description": "Empty when everything is in sync and healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (name, sync_status, health_status) (argocd_app_info{sync_status!=\"Synced\"} or argocd_app_info{health_status!=\"Healthy\"})",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "renameByName": {}
          }
        }
      ],
      "id": 16,
      "gridPos": {
        "h": 6,
        "w": 18,
        "x": 6,
        "y": 29
      }
    },
    {
      "type": "table",
      "title": "Last successful sync per application",
      "description": "Time since the last successful sync (a deploy or a self-heal), from argocd_app_sync_total over 14 days at 15-minute resolution; syncs in the last 24 h.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sort(time() - max by (name) (max_over_time((timestamp(argocd_app_sync_total{phase=\"Succeeded\"}) and (increase(argocd_app_sync_total{phase=\"Succeeded\"}[15m]) > 0))[14d:15m])))",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (name) (increase(argocd_app_sync_total{phase=\"Succeeded\"}[24h]))",
          "refId": "B",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "since last sync"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "syncs (24 h)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "since last sync",
              "Value #B": "syncs (24 h)"
            }
          }
        }
      ],
      "id": 17,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 35
      }
    }
  ]
}
