# TEMPLATE -- copy to mosquitto-users.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/mosquitto-users.sops.yaml
#
# Mosquitto users (apps/home/mosquitto.yaml). One key per MQTT user: the key
# is the username, the value its password. The broker's init container hashes
# them into its password file; config/mosquitto/acl needs a block per user.
# Generate each password with `openssl rand -base64 24`.
#
#   homeassistant  Home Assistant's MQTT integration (set once in the UI)
#   zigbee2mqtt    Zigbee2MQTT (apps/home/zigbee2mqtt.yaml reads this key)
---
apiVersion: v1
kind: Secret
metadata:
  name: mosquitto-users
  namespace: home
type: Opaque
stringData:
  homeassistant: PUT_A_GENERATED_PASSWORD_HERE
  zigbee2mqtt: PUT_A_GENERATED_PASSWORD_HERE
