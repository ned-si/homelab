# TEMPLATE -- copy to paperless-secrets.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/paperless-secrets.sops.yaml
#
# Pulled in with envFrom, so key names become environment variables verbatim.
#
# THREE THINGS TO GENERATE:
#
#   PAPERLESS_SECRET_KEY
#       Django's signing key. This was NEVER SET in the old deployment, so
#       Paperless fell back to the well-known default shipped in its source.
#       Anyone aware of that default could forge session cookies and password
#       reset tokens. Generate one:
#           openssl rand -base64 48
#       Changing it invalidates all existing sessions, which is fine.
#
#   PAPERLESS_ADMIN_PASSWORD
#       Was committed in plaintext. Compromised. Generate:
#           openssl rand -base64 30
#       Note this only creates/updates the admin user at container start.
#
#   the OIDC client secret inside PAPERLESS_SOCIALACCOUNT_PROVIDERS
#       Was committed in plaintext inside that JSON blob. Regenerate it in
#       Keycloak -> Clients -> paperless -> Credentials.
---
apiVersion: v1
kind: Secret
metadata:
  name: paperless-secrets
  namespace: paperless
type: Opaque
stringData:
  PAPERLESS_SECRET_KEY: PUT_A_FRESHLY_GENERATED_DJANGO_SECRET_KEY_HERE
  PAPERLESS_ADMIN_USER: nedsi-admin
  PAPERLESS_ADMIN_PASSWORD: PUT_A_FRESHLY_GENERATED_PASSWORD_HERE
  # Single-line JSON on purpose: Paperless parses this env var as JSON and a
  # folded multi-line YAML scalar would introduce newlines it cannot handle.
  PAPERLESS_SOCIALACCOUNT_PROVIDERS: '{"openid_connect":{"APPS":[{"provider_id":"keycloak","name":"Keycloak","client_id":"paperless","secret":"PUT_THE_NEW_KEYCLOAK_PAPERLESS_CLIENT_SECRET_HERE","settings":{"server_url":"https://auth.lilalala.com/realms/homelab/.well-known/openid-configuration"}}]}}'
