# TEMPLATE -- copy to seafile-db.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/seafile-db.sops.yaml
#
# The MariaDB root password. Read by BOTH the mariadb Deployment
# (MARIADB_ROOT_PASSWORD) and the seafile Deployment (DB_ROOT_PASSWD) -- in the
# old repo the same literal string was pasted into two files, which is how
# passwords drift.
#
# The old value is compromised. Generate a new one:
#     openssl rand -base64 30
#
# CAUTION: MARIADB_ROOT_PASSWORD only takes effect when initialising an EMPTY
# datadir. On an existing database, changing this Secret will make Seafile unable
# to connect while MariaDB keeps the old password. To rotate on a live database:
#     kubectl -n seafile exec deploy/mariadb -- \
#       mariadb -uroot -p'<OLD>' -e "SET PASSWORD FOR 'root'@'%' = PASSWORD('<NEW>');"
# then update this Secret.
#
# Seafile insists on the MariaDB ROOT account rather than a scoped user because
# it creates three databases itself on first run. That is an upstream design
# choice, not something to fix here.
---
apiVersion: v1
kind: Secret
metadata:
  name: seafile-db
  namespace: seafile
type: Opaque
stringData:
  root-password: PUT_A_FRESHLY_GENERATED_PASSWORD_HERE
