# TEMPLATE -- copy to theater-sso.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/theater-sso.sops.yaml
#
# Credentials of the oauth2-proxy `theater-sso` (apps/theater/sso.yaml).
#   client-secret  the secret of the Keycloak client `theater-sso`. The client
#                  is realm code (platform/keycloak/realm/platform.conf,
#                  `proxy_clients`); the keycloak-realm-settings Job sets its
#                  secret from THEATER_SSO_CLIENT_SECRET in
#                  platform/secrets/keycloak-proxy-clients.sops.yaml, which
#                  must hold the same value.
#                  Generate: openssl rand -base64 48 | tr -d '\n=+/' | cut -c1-48
#   cookie-secret  signs the session cookie; 32 bytes, URL-safe base64.
#                  Generate: openssl rand -base64 32 | tr -- '+/' '-_' | tr -d '='
---
apiVersion: v1
kind: Secret
metadata:
  name: theater-sso
  namespace: theater
type: Opaque
stringData:
  client-secret: PUT_THE_KEYCLOAK_THEATER_SSO_CLIENT_SECRET_HERE
  cookie-secret: PUT_A_FRESHLY_GENERATED_COOKIE_SECRET_HERE
