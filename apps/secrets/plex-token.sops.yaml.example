# TEMPLATE -- copy to plex-token.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/plex-token.sops.yaml
#
# The Plex account token the Sonarr and Radarr "Plex Watchlist" import lists
# read the watchlist with (apps/theater/arr-import-lists.yaml). The server's
# own account token is `PlexOnlineToken` in Plex's Preferences.xml.
---
apiVersion: v1
kind: Secret
metadata:
  name: plex-token
  namespace: theater
type: Opaque
stringData:
  PLEX_TOKEN: PUT_THE_PLEX_ACCOUNT_TOKEN_HERE
