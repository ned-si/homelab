# TEMPLATE -- copy to paperless-canary.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/paperless-canary.sops.yaml
#
# The API token of the Paperless user `canary`, read by the paperless-canary
# CronJob (apps/paperless/canary.yaml). `canary` has no group and no
# superuser flag, only the model permissions add, view and delete document,
# so the token sees and deletes only the canary's own pages
# (docs/secrets.md, Rotating a credential).
#
# The token is generated locally (40 hex characters, like a Django REST
# framework token) and given to the user once, in the Paperless pod, as uid
# 1000:
#     kubectl -n paperless exec -i deploy/paperless -- s6-setuidgid paperless \
#       python3 manage.py shell -c "<create the user, set_unusable_password,
#       the three permissions; rest_framework.authtoken Token with the key read
#       from stdin>"
# secrets.local.env key: PAPERLESS_CANARY_TOKEN.
---
apiVersion: v1
kind: Secret
metadata:
  name: paperless-canary
  namespace: paperless
type: Opaque
stringData:
  PAPERLESS_API_TOKEN: PUT_THE_PAPERLESS_CANARY_TOKEN_HERE
