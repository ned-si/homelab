# TEMPLATE -- copy to paperless-export.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/paperless-export.sops.yaml
#
# The passphrase of the nightly export (`document_exporter --passphrase`). It
# encrypts only the sensitive manifest fields; backup-verify's restore test
# needs the same value. Generate: openssl rand -base64 33 | tr -d '/+='
# secrets.local.env key: PAPERLESS_EXPORT_PASSPHRASE.
---
apiVersion: v1
kind: Secret
metadata:
  name: paperless-export
  namespace: paperless
type: Opaque
stringData:
  passphrase: PUT_THE_PAPERLESS_EXPORT_PASSPHRASE_HERE
