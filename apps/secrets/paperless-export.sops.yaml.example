# TEMPLATE -- copy to paperless-export.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/paperless-export.sops.yaml
#
# The passphrase of the nightly Paperless export (apps/paperless/backup.yaml,
# `document_exporter --passphrase`). It encrypts only the sensitive fields of
# manifest.json (the social account tokens of the Keycloak logins); the
# documents and every other field stay plain. The restore test in
# backup-verify needs the same value.
#
# Generate it once: openssl rand -base64 33 | tr -d '/+='
# secrets.local.env key: PAPERLESS_EXPORT_PASSPHRASE.
---
apiVersion: v1
kind: Secret
metadata:
  name: paperless-export
  namespace: paperless
type: Opaque
stringData:
  passphrase: PUT_THE_PAPERLESS_EXPORT_PASSPHRASE_HERE
