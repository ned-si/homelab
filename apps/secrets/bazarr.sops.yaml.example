# TEMPLATE -- copy to bazarr.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/bazarr.sops.yaml
#
# Read by Bazarr's init container and the bazarr-settings Job
# (apps/theater/bazarr.yaml).
#   API_KEY         32 hex characters; Bazarr's own API key
#   ADMIN_PASSWORD  the web login for user `admin` (form)
---
apiVersion: v1
kind: Secret
metadata:
  name: bazarr
  namespace: theater
type: Opaque
stringData:
  API_KEY: PUT_32_HEX_CHARACTERS_HERE
  ADMIN_PASSWORD: PUT_A_GENERATED_PASSWORD_HERE
