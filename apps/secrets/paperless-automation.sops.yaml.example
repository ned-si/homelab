# TEMPLATE -- copy to paperless-automation.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/paperless-automation.sops.yaml
#
# The API token of the Paperless user `automation`, read by the
# paperless-apply PostSync Job and the paperless-apply-nightly CronJob
# (apps/paperless/apply.yaml). `automation` is a superuser with no usable
# password: the token reads and changes every document, through the public
# /api/ too (docs/secrets.md, Rotating a credential).
#
# Create the user and its token once, in the Paperless pod, as uid 1000:
#     kubectl -n paperless exec deploy/paperless -- s6-setuidgid paperless \
#       python3 manage.py shell -c "<create the user, set_unusable_password,
#       is_superuser=True; rest_framework.authtoken Token.objects.get_or_create>"
# secrets.local.env key: PAPERLESS_AUTOMATION_TOKEN.
---
apiVersion: v1
kind: Secret
metadata:
  name: paperless-automation
  namespace: paperless
type: Opaque
stringData:
  PAPERLESS_API_TOKEN: PUT_THE_PAPERLESS_AUTOMATION_TOKEN_HERE
