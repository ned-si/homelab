# TEMPLATE -- copy to homelab-dashboard-github.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/homelab-dashboard-github.sops.yaml
#
# The GitHub token of the homelab-dashboard collector, for the project
# figures every 15 minutes; without it the collector calls GitHub
# anonymously once an hour (.kiro/specs/homelab-dashboard/design.md#sources).
# A fine-grained token: Public repositories, read-only, no permission added,
# no expiry, reviewed yearly (class credential). Collector only.
# secrets.local.env key: HOMELAB_DASHBOARD_GITHUB_TOKEN.
---
apiVersion: v1
kind: Secret
metadata:
  name: homelab-dashboard-github
  namespace: homelab-dashboard
type: Opaque
stringData:
  token: PUT_THE_DASHBOARD_GITHUB_TOKEN_HERE
