# TEMPLATE -- the sealed file is generated, never filled in by hand.
#
# The Ed25519 key the homelab-dashboard collector signs every snapshot push
# with (PKCS #8 PEM, collector only). The web pods verify with the public
# key in apps/homelab-dashboard/push-pubkey.yaml
# (.kiro/specs/homelab-dashboard/design.md#pushing).
#
# Generate it straight into the sealed file, so the private key never lands
# on disk in plaintext, and print the public key for the ConfigMap:
#     key=$(openssl genpkey -algorithm ed25519)
#     printf '%s\n' "$key" | openssl pkey -pubout
#     { sed -n '/^---$/,$p' apps/secrets/homelab-dashboard-push.sops.yaml.example \
#         | sed '/PUT_THE_DASHBOARD_PUSH_PRIVATE_KEY_HERE/d'
#       printf '%s\n' "$key" | sed 's/^/    /'; } \
#       | sops --encrypt --filename-override apps/secrets/homelab-dashboard-push.sops.yaml \
#           --input-type yaml --output-type yaml /dev/stdin \
#       > apps/secrets/homelab-dashboard-push.sops.yaml
# Rotation: docs/secrets.md, Rotating a credential.
---
apiVersion: v1
kind: Secret
metadata:
  name: homelab-dashboard-push
  namespace: homelab-dashboard
type: Opaque
stringData:
  private-key: |
    PUT_THE_DASHBOARD_PUSH_PRIVATE_KEY_HERE
