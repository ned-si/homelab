# TEMPLATE -- copy to mealie-oidc.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/mealie-oidc.sops.yaml
#
# The old value was committed in plaintext as OIDC_CLIENT_SECRET in the Mealie
# Deployment. Regenerate it in Keycloak -> Clients -> mealie -> Credentials.
#
# Key name must be exactly OIDC_CLIENT_SECRET: the Deployment pulls this Secret
# in with envFrom, so the keys become environment variables verbatim.
---
apiVersion: v1
kind: Secret
metadata:
  name: mealie-oidc
  namespace: mealie
type: Opaque
stringData:
  OIDC_CLIENT_SECRET: PUT_THE_NEW_KEYCLOAK_MEALIE_CLIENT_SECRET_HERE
