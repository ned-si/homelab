# TEMPLATE -- copy to immich-config.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/immich-config.sops.yaml
#
# Immich's whole runtime config, mounted with
# `immich.existingConfiguration: immich-config`. A Secret, because Immich
# reads the OIDC client secret only from this file.
# Keys: https://immich.app/docs/install/config-file/
---
apiVersion: v1
kind: Secret
metadata:
  name: immich-config
  namespace: immich
type: Opaque
#
# The key is `immich-config.yaml` (IMMICH_CONFIG_FILE). The content below is
# what runs today. Do not add `storageTemplate` casually: it moves every
# original on disk.
stringData:
  immich-config.yaml: |
    trash:
      enabled: true
      days: 30
    oauth:
      enabled: true
      issuerUrl: https://auth.lilalala.com/realms/homelab
      clientId: immich
      clientSecret: "PUT_THE_NEW_KEYCLOAK_IMMICH_CLIENT_SECRET_HERE"
      scope: openid email profile
      autoLaunch: true
      autoRegister: true
    machineLearning:
      clip:
        enabled: true
        modelName: ViT-B-16-SigLIP-i18n-256__webli
