# TEMPLATE -- copy to immich-config.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/immich-config.sops.yaml
#
# This is Immich's whole runtime configuration (immich-config.json, expressed as
# YAML). The chart mounts it via `immich.existingConfiguration: immich-config`.
#
# WHY THE WHOLE CONFIG IS IN A SECRET RATHER THAN IN HELM VALUES
#   Immich reads the OIDC client secret from this file and offers no environment
#   variable indirection for it. Putting the config in `immich.configuration`
#   renders it into a plain ConfigMap, which is exactly how the old client secret
#   ended up committed. Encrypting the whole file costs some reviewability and is
#   the lesser evil. The non-secret structure is documented right here so the
#   shape stays visible in git.
#
# The old OIDC client secret is COMPROMISED. Regenerate it in
# Keycloak -> Clients -> immich -> Credentials before filling this in.
#
# Reference for every available key: https://immich.app/docs/install/config-file/
---
apiVersion: v1
kind: Secret
metadata:
  name: immich-config
  namespace: immich
type: Opaque
stringData:
  immich-config.json: |
    {
      "trash": {
        "enabled": true,
        "days": 30
      },
      "oauth": {
        "enabled": true,
        "issuerUrl": "https://auth.lilalala.com/realms/homelab",
        "clientId": "immich",
        "clientSecret": "PUT_THE_NEW_KEYCLOAK_IMMICH_CLIENT_SECRET_HERE",
        "scope": "openid email profile",
        "autoLaunch": true,
        "autoRegister": true,
        "buttonText": "Login with Keycloak"
      },
      "passwordLogin": {
        "enabled": true
      },
      "machineLearning": {
        "enabled": true,
        "clip": {
          "enabled": true,
          "modelName": "ViT-B-16-SigLIP-i18n-256__webli"
        }
      },
      "storageTemplate": {
        "enabled": true,
        "template": "{{y}}/{{y}}-{{MM}}-{{dd}}/{{filename}}"
      }
    }
