# TEMPLATE -- copy to seafile-admin.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/seafile-admin.sops.yaml
#
# Pulled in with envFrom, so key names become environment variables verbatim.
#
# The old SEAFILE_ADMIN_PASSWORD was committed in plaintext and is compromised.
# Generate a new one:
#     openssl rand -base64 30
#
# Like the MariaDB root password, this only applies on FIRST initialisation. On
# an existing install, change the password in the Seafile web UI instead and then
# update this Secret to match.
---
apiVersion: v1
kind: Secret
metadata:
  name: seafile-admin
  namespace: seafile
type: Opaque
stringData:
  SEAFILE_ADMIN_EMAIL: nedsi@pm.me
  SEAFILE_ADMIN_PASSWORD: PUT_A_FRESHLY_GENERATED_PASSWORD_HERE
