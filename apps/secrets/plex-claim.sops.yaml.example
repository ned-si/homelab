# TEMPLATE -- copy to plex-claim.sops.yaml, fill in, then seal it with sops.
# The claim token from https://plex.tv/claim (valid for a few minutes, only read
# when the server is claimed for the first time).
---
apiVersion: v1
kind: Secret
metadata:
  name: plex-claim
  namespace: theater
type: Opaque
stringData:
  PLEX_CLAIM: PUT_A_FRESH_PLEX_CLAIM_TOKEN_HERE
