# TEMPLATE -- copy to paperless-config.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/paperless-config.sops.yaml
#
# The accounts of the groups `editors` and `readers` (config/apply.py), as one
# JSON value so no username is a readable key. Entries are usernames or
# Keycloak emails; nedsi-admin, automation and canary cannot be listed. Any
# other account is taken out of both groups.
---
apiVersion: v1
kind: Secret
metadata:
  name: paperless-config
  namespace: paperless
type: Opaque
stringData:
  config.json: '{"editors": ["PUT_THE_EDITOR_USERNAME_OR_EMAIL_HERE"], "readers": ["PUT_THE_READER_USERNAME_OR_EMAIL_HERE"]}'
