# TEMPLATE -- copy to paperless-config.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/paperless-config.sops.yaml
#
# Who is who in Paperless: the accounts of the groups `editors` and `readers`
# (apps/paperless/config/apply.py, design.md "Access"). One key, whose single
# value is a JSON document, so no username or email is ever a readable key.
# Each entry is a Paperless username or the email of the Keycloak account
# (Paperless creates the account on its first login, with that email).
# The accounts nedsi-admin, automation and canary cannot be listed.
# Any other account is taken out of both groups and sees nothing.
---
apiVersion: v1
kind: Secret
metadata:
  name: paperless-config
  namespace: paperless
type: Opaque
stringData:
  config.json: '{"editors": ["PUT_THE_EDITOR_USERNAME_OR_EMAIL_HERE"], "readers": ["PUT_THE_READER_USERNAME_OR_EMAIL_HERE"]}'
