# TEMPLATE -- copy to home-assistant-prometheus.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/home-assistant-prometheus.sops.yaml
#
# Bearer token Prometheus sends to Home Assistant's /api/prometheus
# (apps/home/monitoring.yaml). A long-lived access token of the HA owner:
# profile, Security, Long-lived access tokens, name `prometheus`.
---
apiVersion: v1
kind: Secret
metadata:
  name: home-assistant-prometheus
  namespace: home
type: Opaque
stringData:
  token: PUT_THE_LONG_LIVED_ACCESS_TOKEN_HERE
