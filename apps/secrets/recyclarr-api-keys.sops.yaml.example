# TEMPLATE -- copy to recyclarr-api-keys.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/recyclarr-api-keys.sops.yaml
#
# The Sonarr and Radarr API keys for the Recyclarr CronJob. Each app generates
# its own (Settings -> General -> Security), or:
#
#     kubectl -n theater exec deploy/sonarr -- \
#       sed -n 's|.*<ApiKey>\(.*\)</ApiKey>.*|\1|p' /config/config.xml
#     kubectl -n theater exec deploy/radarr -- \
#       sed -n 's|.*<ApiKey>\(.*\)</ApiKey>.*|\1|p' /config/config.xml
#
# Reseal: set RECYCLARR_SONARR_API_KEY and RECYCLARR_RADARR_API_KEY in
# secrets.local.env, delete the sealed file, run
# scripts/seal-secrets-from-env.sh in the same commit (a missing file fails
# `secrets-apps`). Key names are fixed by `!env_var` in recyclarr.yml.
apiVersion: v1
kind: Secret
metadata:
  name: recyclarr-api-keys
  namespace: theater
type: Opaque
stringData:
  SONARR_API_KEY: PUT_THE_SONARR_API_KEY_HERE
  RADARR_API_KEY: PUT_THE_RADARR_API_KEY_HERE
