# TEMPLATE -- copy to recyclarr-api-keys.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/recyclarr-api-keys.sops.yaml
#
# The Sonarr and Radarr API keys, for the Recyclarr CronJob in
# apps/theater/recyclarr.yaml.
#
# ---------------------------------------------------------------------------
# WHERE THESE VALUES COME FROM
#
# Each app generates its own key on first start and stores it in its database.
# They are NOT in git and cannot be, in either direction: nothing here creates
# them, and there is no way to set them from a manifest.
#
#     Sonarr UI -> Settings -> General -> Security -> API Key
#     Radarr UI -> Settings -> General -> Security -> API Key
#
# or, without a browser:
#
#     kubectl -n theater exec deploy/sonarr -- \
#       sed -n 's|.*<ApiKey>\(.*\)</ApiKey>.*|\1|p' /config/config.xml
#     kubectl -n theater exec deploy/radarr -- \
#       sed -n 's|.*<ApiKey>\(.*\)</ApiKey>.*|\1|p' /config/config.xml
#
# Both are 32 lowercase hex characters.
#
# ---------------------------------------------------------------------------
# RESEALING
#
# A Sonarr or Radarr key changes only when it is regenerated in the app. Then:
#     1. read both keys with the commands above
#     2. put them in secrets.local.env as RECYCLARR_SONARR_API_KEY and
#        RECYCLARR_RADARR_API_KEY
#     3. delete apps/secrets/recyclarr-api-keys.sops.yaml and run
#        scripts/seal-secrets-from-env.sh (it seals only missing files)
#
# The file must never be absent from git: KSOPS resolves every file listed in
# ./secret-generator.yaml, and a missing one fails the whole `secrets-apps`
# Application.
#
# ---------------------------------------------------------------------------
# KEY NAMES ARE FIXED BY THE CONFIG, NOT BY CHOICE
#
# apps/theater/recyclarr.yaml mounts this Secret with `envFrom` and its
# recyclarr.yml refers to the values as `!env_var SONARR_API_KEY` /
# `!env_var RADARR_API_KEY`. Rename a key here and the sync fails with
# "environment variable not set", which reads like a missing Secret rather than a
# renamed one.
#
# The base URLs are NOT here. They are in-cluster Service addresses, not
# credentials, so they are plaintext in the ConfigMap alongside the config that
# uses them.
apiVersion: v1
kind: Secret
metadata:
  name: recyclarr-api-keys
  namespace: theater
type: Opaque
stringData:
  SONARR_API_KEY: PUT_THE_SONARR_API_KEY_HERE
  RADARR_API_KEY: PUT_THE_RADARR_API_KEY_HERE
