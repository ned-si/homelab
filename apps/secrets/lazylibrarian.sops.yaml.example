# TEMPLATE -- copy to lazylibrarian.sops.yaml, fill in, then:
#     task secrets:seal -- apps/secrets/lazylibrarian.sops.yaml
#
# Read by the LazyLibrarian init container (apps/theater/lazylibrarian.yaml),
# which writes the values into config.ini.
#   HTTP_USER / HTTP_PASS     the web login (form)
#   API_KEY                   32 hex characters; Prowlarr's LazyLibrarian
#                             application uses it to push indexers
#   QBITTORRENT_USER / _PASS  the qBittorrent WebUI login the *arr apps use
---
apiVersion: v1
kind: Secret
metadata:
  name: lazylibrarian
  namespace: theater
type: Opaque
stringData:
  HTTP_USER: admin
  HTTP_PASS: PUT_A_GENERATED_PASSWORD_HERE
  API_KEY: PUT_32_HEX_CHARACTERS_HERE
  QBITTORRENT_USER: PUT_THE_QBITTORRENT_USER_HERE
  QBITTORRENT_PASS: PUT_THE_QBITTORRENT_PASSWORD_HERE
