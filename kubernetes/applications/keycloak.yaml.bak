apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: keycloak
  namespace: argo
spec:
  destination:
    namespace: identity
    server: https://kubernetes.default.svc
  project: default
  source:
    chart: keycloak
    helm:
      releaseName: keycloak
      values: |
        proxyAddressForwarding: true
        ingress:
          ingressClassName: traefik
          enabled: true
          hostname: keycloak.10.0.10.68.nip.io
          annotations:
            cert-manager.io/cluster-issuer: letsencrypt
          tls: true
    repoURL: "https://charts.bitnami.com/bitnami"
    targetRevision: v18.3.3
  syncPolicy:
    automated: {}
    syncOptions:
      - CreateNamespace=true
