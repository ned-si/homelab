# TEMPLATE -- copy to cloudflare-external-dns.sops.yaml, fill in the token, then:
#     task secrets:seal -- infrastructure/secrets/cloudflare-external-dns.sops.yaml
#
# Cloudflare API token, scoped to the lilalala.com zone:
#     Zone / Zone / Read
#     Zone / DNS  / Edit
#
# A separate token from cert-manager, so each can be revoked alone. Same
# Secret name, different namespace.
---
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-api-token-secret
  namespace: external-dns
type: Opaque
stringData:
  api-token: PUT_THE_EXTERNAL_DNS_CLOUDFLARE_TOKEN_HERE
