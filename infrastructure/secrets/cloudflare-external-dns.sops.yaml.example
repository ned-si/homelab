# TEMPLATE -- copy to cloudflare-external-dns.sops.yaml, fill in the token, then:
#     task secrets:seal -- infrastructure/secrets/cloudflare-external-dns.sops.yaml
#
# Cloudflare API token permissions, scoped to the lilalala.com zone only:
#     Zone / Zone / Read
#     Zone / DNS  / Edit
#
# Separate token from the cert-manager one, on purpose: external-dns writes
# records continuously and is the more likely of the two to be compromised by a
# supply-chain problem, so it should be independently revocable.
---
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-api-token
  namespace: external-dns
type: Opaque
stringData:
  api-token: PUT_THE_EXTERNAL_DNS_CLOUDFLARE_TOKEN_HERE
