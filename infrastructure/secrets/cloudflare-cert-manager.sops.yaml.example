# TEMPLATE -- copy to cloudflare-cert-manager.sops.yaml, fill in the token, then:
#     task secrets:seal -- infrastructure/secrets/cloudflare-cert-manager.sops.yaml
#
# Cloudflare API token permissions, scoped to the lilalala.com zone only:
#     Zone / Zone / Read
#     Zone / DNS  / Edit
#
# Use a SEPARATE token from the external-dns one so either can be revoked
# without taking the other down.
#
# The token that used to sit in this repo in plaintext is COMPROMISED. Revoke it
# in the Cloudflare dashboard before creating this one.
#
# NAME MATTERS: `cloudflare-api-token-secret` is what the running cluster already
# uses, in both this namespace and external-dns. An earlier draft called it
# `cloudflare-api-token`, which is tidier and would have broken certificate
# renewal on contact: the ClusterIssuer would have pointed at a Secret that does
# not exist, renewal would fail quietly, and all ten certificates would have
# expired. Sealing this file therefore REPLACES the existing Secret in place
# rather than creating a second one.
---
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-api-token-secret
  namespace: cert-manager
type: Opaque
stringData:
  api-token: PUT_THE_CERT_MANAGER_CLOUDFLARE_TOKEN_HERE
