# TEMPLATE -- copy to cloudflare-cert-manager.sops.yaml, fill in the token, then:
#     task secrets:seal -- infrastructure/secrets/cloudflare-cert-manager.sops.yaml
#
# Cloudflare API token, scoped to the lilalala.com zone:
#     Zone / Zone / Read
#     Zone / DNS  / Edit
#
# A separate token from external-dns, so each can be revoked alone. The name
# `cloudflare-api-token-secret` is what the ClusterIssuer reads; sealing
# replaces the Secret in place.
---
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-api-token-secret
  namespace: cert-manager
type: Opaque
stringData:
  api-token: PUT_THE_CERT_MANAGER_CLOUDFLARE_TOKEN_HERE
