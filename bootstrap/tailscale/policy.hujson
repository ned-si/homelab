// Tailnet policy of `ned-si.github`. The source of truth is this file:
// .github/workflows/tailscale-policy.yaml tests it on pull requests and
// applies it on merge to main (docs/remote-access.md, "Tailnet policy").
// It replaces the default allow-all policy.
{
	"tagOwners": {
		// The operator's OAuth client carries this tag.
		"tag:k8s-operator": [],
		// Every proxy the operator creates (Tailscale Ingress, Service).
		"tag:k8s": ["tag:k8s-operator"],
		// The exit node on the home connection (Connector `home-exit`).
		"tag:exit": ["tag:k8s-operator"],
		// The Talos nodes (siderolabs/tailscale extension), which log in
		// with the operator's OAuth client secret (talos/talconfig.yaml).
		"tag:talos": ["tag:k8s-operator"],
	},

	// The exit node needs no approval in the admin console.
	"autoApprovers": {
		"exitNode": ["tag:exit"],
	},

	// IP pool: new devices get an address in 100.96.0.0-100.127.255.255,
	// minus Tailscale's reserved 100.100.0.0/22 and 100.115.0.0/16 blocks.
	// A corporate VPN on a member's laptop routes 100.72.0.0-100.95.255.255
	// into its own tunnel, so tailnet devices there are unreachable from it
	// (docs/remote-access.md, "Address range").
	"nodeAttrs": [
		{
			"target": ["*"],
			"ipPool": [
				"100.96.0.0/14",
				"100.104.0.0/13",
				"100.112.0.0/15",
				"100.114.0.0/16",
				"100.116.0.0/14",
				"100.120.0.0/13",
			],
		},
	],

	"grants": [
		// A member's own devices reach each other, as before.
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:self"],
			"ip":  ["*"],
		},
		// Members reach the cluster's tailnet services over HTTPS only. Each
		// app keeps its own login (Keycloak).
		{
			"src": ["autogroup:member"],
			"dst": ["tag:k8s"],
			"ip":  ["tcp:443"],
		},
		// Members use an exit node for the internet only: not the home LAN,
		// not the cluster.
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:internet"],
			"ip":  ["*"],
		},
		// The owner and admins reach the Kubernetes API server proxy, which
		// impersonates them as the group `tailnet-admins`
		// (platform/tailscale-operator/resources/rbac.yaml).
		{
			"src": ["autogroup:owner", "autogroup:admin"],
			"dst": ["tag:k8s-operator"],
			"ip":  ["tcp:443"],
			"app": {
				"tailscale.com/cap/kubernetes": [
					{"impersonate": {"groups": ["tailnet-admins"]}},
				],
			},
		},
		// The owner and admins reach the Talos API (apid, mTLS with the
		// talosconfig) on the nodes; nothing else reaches tag:talos, and
		// tag:talos reaches nothing.
		{
			"src": ["autogroup:owner", "autogroup:admin"],
			"dst": ["tag:talos"],
			"ip":  ["tcp:50000"],
		},
	],

	// Tailscale SSH between a member's own devices, with a periodic re-check
	// (the default rule).
	"ssh": [
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
	],
}
